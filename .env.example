# Gemini 图片生成器 - 供应商配置
# =====================================
#
# 配置格式：
#   <供应商名称>_API_KEY=your_api_key
#   <供应商名称>_BASE_URL=https://api.example.com
#
# 系统会自动扫描所有以 _API_KEY 结尾的环境变量，提取供应商名称。
# 你可以添加任意数量的供应商，只需按照上述格式配置即可。
#
# =====================================

# === Aihubmix 供应商 ===
AIHUBMIX_API_KEY=your_aihubmix_api_key_here
AIHUBMIX_BASE_URL=https://aihubmix.com/gemini

# === DMX 供应商 ===
DMX_API_KEY=your_dmx_api_key_here
DMX_BASE_URL=https://www.dmxapi.cn

# === Google 官方 (示例) ===
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# === 添加更多供应商 ===
# 只需按照以下格式添加：
# <名称>_API_KEY=your_api_key
# <名称>_BASE_URL=https://your-api-url.com
